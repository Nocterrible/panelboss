<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- ============ THE UPGRADE CODE IS LOAD-BEARING ============
       {2B6EC257-4870-49BB-AD89-58B577292C37} - generated with
       New-Guid on 2026-10-21. Every PanelBoss MSI ever built shares
       it; changing it strands every installed copy (the upgrade
       scan matches on THIS value, not on the product name). Do not
       move it, do not regenerate it. ProductCode stays "*" (fresh
       per build, which is exactly right).
       The owner laws (AUDIT-PUNCHLIST "MSI WAVE REQUIREMENTS"):
       law 1: InstallScope=perUser + InstallPrivileges=limited +
              the whole tree under %LOCALAPPDATA% - no elevation
              ambush at install, uninstall, or upgrade.
       law 2: Start Menu entry below (name + icon, bare launch of
              the GUI; the Run-key autostart remains the app's own
              opt-in - the shortcut is the discoverability half).
       law 3: PanelBossCleanup below - the uninstall runs the
              installed exe's cleanup verb: the CCD disconnects
              first, the Run key, then OUR task, every line honest,
              exit 0 always.
       law 4: the data files ride the heat harvest: files.wxs is
              GENERATED by scripts/build_msi.ps1 from the onedir
              (dist\msi\files.wxs, not checked in) - no hand-maintained
              file list can rot.
       Publisher: no identity exists in README/CHANGELOG (grepped
       Oct 21), so per the wave packet Manufacturer is the repo
       owner's git config user.name: "Tyler". -->
  <Product Id="*" Name="PanelBoss" Language="1033"
           Version="$(var.Version)"
           Manufacturer="Tyler"
           UpgradeCode="{2B6EC257-4870-49BB-AD89-58B577292C37}">
    <Package InstallerVersion="200" Compressed="yes"
             InstallScope="perUser" InstallPrivileges="limited"
             Description="PanelBoss - presence-aware display control (per-user)"
             Comments="per-user install, no elevation (MSI wave laws)"/>
    <!-- SAME-VERSION UPGRADES ON (Oct 25): without the flag a
     same-version reinstall lands BESIDE the old product (three
     ghost PanelBosses proved it the hard way); with it, the old
     product code retires cleanly. The in-app updater always
     version-bumps, so this only ever helps re-ships. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer PanelBoss is already installed."/>
    <MediaTemplate EmbedCab="yes"/>

    <Icon Id="panelboss.ico" SourceFile="$(var.Icon)\panelboss.ico"/>
    <Property Id="ARPPRODUCTICON" Value="panelboss.ico"/>
    <Property Id="ARPCOMMENTS"
              Value="Per-user install. Uninstall cleans the power task, the Run key, and every display this app left disconnected."/>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicRtf)"/>
    <UIRef Id="WixUI_Minimal"/>

    <!-- ============ the finish page asks before it launches ============
         WiX's own run_program_after_install how-to, verbatim shape.
         The Minimal template's finish dialog (WixUIExtension's
         ExitDialog, read at tag wix3141rtm ExitDialog.wxs) ALREADY
         ships the optional checkbox (OptionalCheckBox,
         Property=WIXUI_EXITDIALOGOPTIONALCHECKBOX CheckBoxValue=1,
         shown via ControlCondition when
         WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT is set and NOT
         Installed) - so the library shape needs no custom dialog,
         just the properties below plus one Publish row. Property
         CHECKBOX=1 makes the box appear CHECKED at dialog init;
         unchecking publishes 0 and the Publish condition stops
         matching. WixShellExecTarget points at the harvested exe:
         the fil id is heat's name-hash, - stable across re-harvest of the fixed
          path (a path-hash, not a content checksum).
          Impersonate=yes (the default) is present for clarity -
         (diff-verified against a fresh heat run before referencing).
         the user-context guarantee is the type-1 in-session, free-threaded DLL CA + per-user scope - WixShellExec lands in the installing user's session, never an elevated context. Return: candle
         REFUSES asyncNoWait on a DllEntry CA ('requires ExeCommand',
         CNDL0038) - MSI's async+continue bits are EXE-only
         (msi/custom-action-return-processing-options). The
         no-wait guarantee lives in the CA itself instead: WixCA's
         WixShellExec docs state it 'launches an application without
         waiting for it to close', so the install closing never
         waits on PanelBoss. NOT Installed guard mirrors the
         how-to: repair/modify must not launch. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"/>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Launch PanelBoss when the installer closes"/>
    <Property Id="WixShellExecTarget"
              Value="[#filAEEF82E925FC1F1406CA08D75C4068DC]"/>
    <CustomAction Id="LaunchApplication" BinaryKey="WixCA"
                  DllEntry="WixShellExec" Impersonate="yes"/>
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="LaunchApplication" Order="1">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
    </UI>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="PanelBoss"/>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="PanelBoss"/>
      </Directory>
    </Directory>

    <!-- law 2. The HKCU marker is the component key path (every
         component needs one and a shortcut cannot be one): per-user
         hive, removed with the component; MSI's own Add/Remove
         registration also lives in HKCU. "No registry writes" in
         the law means no HKLM - this file keeps that promise. -->
    <Component Id="StartMenuShortcut" Guid="*" Directory="AppMenuFolder">
      <Shortcut Id="PanelBossStart" Name="PanelBoss"
                Target="[INSTALLDIR]PanelBoss.exe"
                WorkingDirectory="INSTALLDIR" Icon="panelboss.ico"/>
      <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall"/>
      <RegistryValue Root="HKCU" Key="Software\PanelBoss"
                     Name="startmenu" Type="integer" Value="1" KeyPath="yes"/>
    </Component>

    <!-- law 3's uninstall half. WHY EXECUTE="immediate" (gate round 3,
         Oct 25, bit naming corrected at the reviewer's pass): the old
         deferred shape compiled to type 1122 = 0x462 (read from the
         WindowsInstaller COM, not inferred): base 98 - exe,
         Directory-sourced, command line in Target - plus 0x400, the
         IN-SCRIPT bit (msidbCustomActionTypeInScript): the act was
         deferred, period. NoImpersonate is 0x800 and was NOT set, so
         Impersonate="yes" was honored in the bits; the earlier
         "0x400 NO-IMPERSONATION" naming was a confusion. What the
         receipts actually prove: the act NEVER LAUNCHED - the /L*v
         shows error 1721 (the Directory + bare relative command has
         no proven resolution at the service's end; Defender PUA
         quarantines of the fresh unsigned exe raced those minutes, so
         relative-command resolution stays UNTESTED rather than
         trusted), Return=ignore swallowed it, no cleanup line landed
         in the user's or SYSTEM's log, and the systemprofile tree was
         never created. The doors survived because the act never
         spoke. Two traps, one fix:
         Execute="immediate" runs the act in the CLIENT process -
         msiexec runs in the uninstalling user's token, so HKCU, the
         user's own task, and the user's own LOCALAPPDATA are the
         right hive, and the act writes where the user can see it.
         PROVEN on the desk (/L*v clean, four cleanup lines in the
         user's log at the uninstall minute, the HKCU door gone, the
         systemprofile tree never created).
         The classic property-expansion trap that
         forced deferred CAs ([INSTALLDIR] not expanding) applies to
         the DEFERRED context only: immediate sees properties and
         expands them in place. The command is now the FileKey form
         (the act names the harvested PanelBoss.exe component file
         directly - the same file identity the working
         LaunchApplication act above points at; the installer expands
         it to the absolute quoted path, so a user path with spaces
         survives and no cwd resolution is involved), and the cleanup
         verb is cwd-independent by construction. The same
         InstallExecuteSequence position is kept - after
         InstallInitialize, before RemoveFiles: the exe is still on
         disk to speak its cleanup. The condition excludes the old
         product's remove phase of a major or same-version upgrade:
         WIX_UPGRADE_DETECTED / WIX_DOWNGRADE_DETECTED cover the
         installing side, and UPGRADINGPRODUCTCODE (MSI's own
         property, set in the removed product's session) is the one
         that actually quiets the act during RemoveExistingProducts -
         measured: with the WiX clauses alone the guarded act still
         fired its sweep mid-upgrade. An upgrade must not eat the
         user's opt-ins - the Run key, the browser
         door, and the task belong to the installed app, not to the
         retiring product code. Return=ignore is the second belt
         (the verb already exits 0): a locked exe or an AE-mandated
         reboot may not fail the uninstall; the cleanup re-runs fine
         after the reboot. -->
    <CustomAction Id="PanelBossCleanup"
                  FileKey="filAEEF82E925FC1F1406CA08D75C4068DC"
                  ExeCommand="cleanup"
                  Execute="immediate" Impersonate="yes" Return="ignore"/>
    <InstallExecuteSequence>
      <Custom Action="PanelBossCleanup" After="InstallInitialize">REMOVE AND NOT WIX_UPGRADE_DETECTED AND NOT WIX_DOWNGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <Feature Id="App" Title="PanelBoss" Level="1" Absent="disallow"
             Display="hidden">
      <ComponentGroupRef Id="PanelBossFiles"/>
      <ComponentRef Id="StartMenuShortcut"/>
    </Feature>
  </Product>
</Wix>
