# environments
.venv/
setup.json

# models (downloaded by scripts/setup.ps1)
models/*.onnx

# runtime state
logs/
__pycache__/
*.pyc

# build artifacts
build/
dist/
*.egg-info

# native-messaging host build (built by extension/host/install_host.ps1)
extension/host/panelboss-host.exe
extension/host/build/
extension/host/host-manifest.json

# the companion's RSA private half (Oct 16 key pin) - the public half
# lives in manifest.json, the id in companion_key.txt; losing the
# private pem means never rotating the key, never republishing under
# a regenerated one. It stays on the build machine, out of git.
extension/host/companion_private_key_pkcs8.pem

# optional extras
.faces/

# suite runner logs
scripts/suite_*.log

# pyinstaller spec (build_msi/build_release write it at the repo root)
PanelBoss.spec
