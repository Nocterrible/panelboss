+        line.pack(fill="x", padx=theme.S_FIELD, pady=(0, theme.S_FIELD))
+        entry = ctk.CTkEntry(line, font=self.skin.font(12))
+        entry.insert(0, spec["prefill"])
+        entry.pack(side="left", fill="x", expand=True)
