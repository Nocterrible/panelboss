+        # fails FAST. destroy() alone does not always end the loop
+        # (the half-built second window kills Tk's auto-command
+        # table); quit() is the Tcl-level break that does.
+        try:
+            app.destroy()
+        except Exception:
+            pass
+        try:
+            app.quit()
+        except Exception:
+            pass
 
 
 def _watchdog():
     print("WATCHDOG FIRED after 60 s", flush=True)
+    # the standing bracket's instrument (exit-path hang, three bites):
+    # name every still-alive thread at the bite - the class is a
+    # thread holding the interpreter (or the loop) open past the
+    # [PASS] prints, and a watchdog without a census is a timestamp.
+    print("threads alive at bite:", flush=True)
+    for t in threading.enumerate():
+        print("  %-24s daemon=%s alive=%s" % (t.name, t.daemon,
+                                              t.is_alive()), flush=True)
     FAILED.append("watchdog")
     app.destroy()
 
@@ -455,6 +581,10 @@ def _hard_kill():
     print("HARD KILL after 120 s: the Tk event loop stopped "
           "processing - killing so the sweep cannot hang",
           flush=True)
+    print("threads alive at kill:", flush=True)
+    for t in threading.enumerate():
+        print("  %-24s daemon=%s alive=%s" % (t.name, t.daemon,
+                                              t.is_alive()), flush=True)
     os._exit(3)
 
 
diff --git a/scripts/hdr_live_probe.py b/scripts/hdr_live_probe.py
new file mode 100644
index 0000000..dffe9f0
--- /dev/null
+++ b/scripts/hdr_live_probe.py
@@ -0,0 +1,53 @@
+"""Live-tool, NOT in run_all (it flickers the owner's desk twice -
+the gauntlet must never do that): the amendment-8 round trip plus
+the WM_DISPLAYCHANGE ear check on the real driver. Run by hand when
+someone is watching the screens."""
+import sys
+import time
+
+sys.path.insert(0, ".")
+
+from panelboss import display, wm  # noqa: E402
+
+rows = wm.hdr_states()
+print("hdr_states:")
+for r in rows:
+    print("  %-14s supported=%-5s state=%-7s precise=%s"
+          % (r["model"] or "?", r["supported"], r["state"], r["precise"]))
+cap = next((r for r in rows if r.get("supported") and r.get("precise")),
+           None)
+if cap is None:
+    print("no capable readable panel - round trip impossible HERE; "
+          "honest exit 0")
+    sys.exit(0)
+
+d = display.Display(verbose=False)
+d.start()
+time.sleep(0.5)
+
+start = cap["state"]
+want = start != "on"
+print("flip: %s -> %s" % (start, "on" if want else "off"))
+say = wm.hdr_set(cap["gdi"], want)
+print("set: %r" % say)
+time.sleep(2.0)
+back = {r["model"]: r for r in wm.hdr_states()}[cap["model"]]["state"]
+print("read-back: %s  (wanted %s)" % (back, "on" if want else "off"))
+say2 = wm.hdr_set(cap["gdi"], start == "on")
+print("restore: %r" % say2)
+time.sleep(1.0)
+end = {r["model"]: r for r in wm.hdr_states()}[cap["model"]]["state"]
+print("restored: %s" % end)
+time.sleep(0.5)
+got = []
+while True:
+    try:
+        got.append(d.queue.get_nowait())
+    except Exception:
+        break
+dc = [g for g in got if g[0] == "displaychange"]
+print("queue: %r" % (got,))
+d.stop()
+ok = (back == ("on" if want else "off")) and end == start and dc
+print("ROUND TRIP OK" if ok else "LIVE CHECK FAILED")
+sys.exit(0 if ok else 1)
diff --git a/scripts/hdrwake_test.py b/scripts/hdrwake_test.py
new file mode 100644
index 0000000..99cf4ae
--- /dev/null
+++ b/scripts/hdrwake_test.py
@@ -0,0 +1,206 @@
+"""THE HDR-WAKE FREEZE PIN (the freeze-fix wave, Oct 14): at wake a
+WM_DISPLAYCHANGE rides ui_events as hdr_sync, and the drain arm re-reads
+the profiles pane's driver truth - live_modes and hdr_states. Against a
+COLD driver that walk measured 16-38 s (the class camera.py:56-58 names
+for an OPEN; the owner's window died ~20 s at 07:19, back-solved through
+the idle-gate arithmetic) - and the arm walked it SYNCHRONOUSLY ON THE
+TK PUMP. The camera side learned this driver's resume tax the WARMING
+way (0ffa77e); this pin buries the last pump-side holdout, five arms:
+  (i)   after the boot render, the pane's driver walks never name
+        MainThread;
+  (ii)  the pump stayed RESPONSIVE through the walk - >= 5 app.update()
+        cycles RETURNED while the stand-ins slept (the freeze signature
+        is a stuck pump, not merely a wrong thread name);
+  (iii) the payload rides back through the SAME ui_events queue and the
+        pane consumes it: the resolution menu carries the LATEST fake
+        answer and no older one;
+  (iv)  STORM LAW: posts landing during an in-flight walk coalesce -
+        three of them are ONE worker call plus ONE latest-wins re-run,
+        never a queue of walks;
+  (v)   the static ban: the text _profiles_render( may not sit between
+        the hdr_sync arm and the next drain arm (the exit-path wave's
+        file-ban idiom) - the pump may never walk the driver there.
+App-up compatible BY DESIGN (the switch_geom_probe idiom: temp
+PANELBOSS_CONFIG_DIR, fake desk, and no CTkToplevel is ever opened). A
+wedged pump hard-kills at 60 s with rc=3 - the run_all table's code."""
+import os
+import queue
+import sys
+import tempfile
+import threading
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+SCRATCH = tempfile.mkdtemp(prefix="panelboss_hdrwake_")
+os.environ["PANELBOSS_CONFIG_DIR"] = SCRATCH
+
+from panelboss import config, power
+from panelboss import profiles as PF
+from panelboss import wm as WM
+
+cfg = config.get_config(verbose=False)
+cfg["camera"]["enabled"] = False
+cfg["ui"]["start_minimized"] = True      # the tray app's birth
+cfg["restore"]["enabled"] = False
+
+# the cold-driver stand-ins: every walk records the THREAD that walked
+# it and sleeps 1.5 s; each answer describes a DIFFERENT desk (mode
+# marker moves with the call number) so the pane can only be proven to
+# have consumed the LATEST payload by seeing that marker and not the
+# previous one.
+CALLS = []                               # (kind, thread-name)
+
+def _live_modes():
+    CALLS.append(("modes", threading.current_thread().name))
+    time.sleep(1.5)
+    n = sum(1 for k, _ in CALLS if k == "modes")     # this call's number
+    # the desk MOVES under every walk: the pane can only be proven to
+    # carry the LATEST answer by seeing this call's marker and not the
+    # previous call's
+    return {"MONITOR\\T": ["100x100@60", "%d00x%d00@60" % (n + 1, n + 1)]}
+
+
+def _hdr_states():
+    CALLS.append(("hdr", threading.current_thread().name))
+    time.sleep(1.5)
+    on = sum(1 for k, _ in CALLS if k == "hdr") >= 2
+    return [{"gdi": r"\\.\DISPLAY1", "model": "T", "supported": True,
+             "state": "on" if on else "off", "mode": 2 if on else 0,
+             "precise": True}]
+
+
+PF.path = lambda dir=None: os.path.join(SCRATCH, "profiles.json")
+_FAKE_DESK = [{"id": "MONITOR\\T", "short": "T",
+               "gdi": r"\\.\DISPLAY1", "x": 0, "y": 0, "w": 100,
+               "h": 100, "rate": 60, "bits": 32, "primary": True}]
+WM.monitors = lambda: [dict(m) for m in _FAKE_DESK]
+WM.fingerprint = lambda: "TESTFP"
+WM.list_windows = lambda: []
+WM.launch = lambda exe: ""
+WM.rescue_lost = lambda: []
+WM.place = lambda h, r, z=False: "ok"
+WM.hdr_states = _hdr_states
+WM.offered_modes = lambda gdi, limit=400: ["100x100@60"]
+PF.live_modes = _live_modes
+power.task_installed = lambda: True
+from panelboss import camera as cam
+cam.optional_present = lambda pkg: False
+cam.hello_ir_names = lambda: []
+
+from panelboss.state import FrameBox
+from panelboss.ui import window as W
+W.SettingsWindow._scan_cameras = lambda self: None
+W.ctk.CTkToplevel._deactivate_windows_window_header_manipulation = True
+
+fm = type("FM", (), {})()
+fm.state = "counting"
+fm.paused = False
+fm.re_off_paused = False
+fm.events = queue.Queue()
+fm.framebox = FrameBox()
+fm.blockers = {"error": None, "display": [], "other": []}
+
+FAILED = []
+
+
+def check():
+    global FAILED
+    app = None
+    try:
+        app = W.SettingsWindow(cfg, fm, queue.Queue())
+        app._prof_name.insert(0, "wake desk")
+        app._profile_create()            # boot render walked, MainThread
+        app._show_tab("monitor profiles")
+        app.update()
+        base = len(CALLS)
+
+        def pump(seconds):
+            """real drain: the tick chain armed in __init__ drains
+            ui_events on every due timer; returns the cycle count"""
+            n = 0
+            t0 = time.time()
+            while time.time() - t0 < seconds:
+                app.update()
+                n += 1
+            return n
+
+        # the ride-up, driven through the REAL arm: one post, and while
+        # the walk is in flight three more (the storm)
+        app.ui_events.put(("hdr_sync", None))
+        cycles = pump(1.0)               # the spawn drains here
+        for _ in range(3):
+            app.ui_events.put(("hdr_sync", None))
+        cycles += pump(8.0)              # BOTH walks' sleep windows
+                                         # (3 s each, back to back):
+                                         # the pump must stay alive
+                                         # clean through them
+        walk_names = {n for k, n in CALLS[base:]}
+        walks = sum(1 for k, _ in CALLS[base:] if k == "modes")
+
+        # (i) after the boot render, the walks never name MainThread
+        assert "MainThread" not in walk_names, \
+            "the pane walked the driver ON THE PUMP: %s" % sorted(
+                walk_names)
+        # (ii) the freeze signature is a stuck pump, not just a name
+        assert cycles >= 5, \
+            "the pump froze during the walk: %d update cycles returned " \
+            "in the sleep window (the freeze, measured)" % cycles
+        # (iv) STORM LAW: four posts = one walk + one latest-wins re-run
+        assert walks == 2, \
+            "storm law broken: %d walks for 4 posts (one + one re-run " \
+            "is the law)" % walks
+        # (iii) the pane consumed the LATEST payload (marker of walk 2;
+        # walk 1's marker gone: latest wins, not first lands)
+        app.update()
+        res_menu = app._mode_menus["MONITOR\\T"][0]
+        vals = str(res_menu.cget("values")).replace(" ", "")
+        last_n = sum(1 for k, _ in CALLS if k == "modes")   # total
+        assert "%d00x%d00" % (last_n + 1, last_n + 1) in vals, \
+            "the pane never consumed the walk's payload: %s" % vals
+        assert "%d00x%d00" % (last_n, last_n) not in vals, \
+            "a superseded payload still paints (latest must win): %s" \
+            % vals
+        print("[PASS] hdr wake: pump alive through the walk (%d cycles), "
+              "%d walks for 4 posts, latest payload consumed (%s)"
+              % (cycles, walks, vals))
+    except Exception:
+        FAILED.append("check")
+        __import__("traceback").print_exc()
+    finally:
+        try:
+            if app is not None:
+                app.destroy()
+        except Exception:
+            pass
+
+
+def ban():
+    """(v) the static arm: the pump-side walk is banned from the
+    hdr_sync arm's text (file-ban idiom of the exit-path wave)"""
+    src = open(os.path.join(os.path.dirname(
+        os.path.dirname(os.path.abspath(__file__))),
+        "panelboss", "ui", "window", "_runtime.py"),
+        encoding="utf-8").read()
+    a = src.index('if message == "hdr_sync":')
+    b = src.index("if message ==", a + 30)
+    seg = src[a:b]
+    if "_profiles_render(" in seg:
+        FAILED.append("ban")
+        print("[FAIL] ban: hdr_sync arm still holds _profiles_render("
+              " on the pump")
+
+
+def _hard_kill():
+    time.sleep(60)
+    print("HARD KILL after 60 s (rc=3 contract)", flush=True)
+    os._exit(3)
+
+
+threading.Thread(target=_hard_kill, daemon=True).start()
+check()
+ban()
+if FAILED:
+    print("HDR WAKE PIN FAILED in", FAILED)
+    sys.exit(1)
+print("HDR WAKE PIN OK")
diff --git a/scripts/hdrwatch_test.py b/scripts/hdrwatch_test.py
new file mode 100644
index 0000000..2df00e5
--- /dev/null
+++ b/scripts/hdrwatch_test.py
@@ -0,0 +1,215 @@
+"""The amendment-8 offline suite: the PDH/pipe vocabulary (path
+strings and the engine-family matcher, against the shapes MEASURED
+on this box - no live counters), the mpv matcher truth table, the
+hysteresis machine on a fake clock, the arm over faked senses, and
+the type-16 migration-canary pins. No window, no counters, no
+pipes, no driver: the suite that needs those is the live probe, not
+this file. Run: .venv\\Scripts\\python.exe scripts\\hdrwatch_test.py
+"""
+import os
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+os.environ["PANELBOSS_CONFIG_DIR"] = tempfile.mkdtemp(
+    prefix="panelboss_hdr_")
+
+from panelboss import config                      # noqa: E402
+from panelboss.wm import _hdr, _videostats as vs  # noqa: E402
+from panelboss.state import _hdrwatch as hw       # noqa: E402
+
+fails = []
+
+
+def check(cond, name):
+    print(("PASS " if cond else "FAIL ") + name)
+    if not cond:
+        fails.append(name)
+
+
+# ---- 1) the counter vocabulary: strings, not syscalls -----------------
+check(vs.OBJECT == "GPU Engine"
+      and vs.COUNTER == "Utilization Percentage"
+      and vs.COUNTER_PATH == "\\GPU Engine(%s)\\Utilization Percentage",
+      "path table is the one measured on this desk (English path, "
+      "locale-proof door)")
+check(vs.MPV_PIPE_DEFAULT
+      == config.DEFAULTS["hdr"]["mpv_pipe"],
+      "the pipe default in _videostats IS the config default (one truth)")
+# the matcher over the instance shapes measured here (NVIDIA glues
+# the words, the iGPU spells them with spaces - one normalizer eats
+# both) and the rejections the law demands
+check(vs.is_video_instance(
+    "pid_104676_luid_0x00000000_0x0001A1DF_phys_0_eng_1_"
+    "engtype_VideoDecode"), "NVIDIA VideoDecode instance is video")
+check(vs.is_video_instance(
+    "pid_9_luid_0x0_0x1_phys_0_eng_9_engtype_video decode 1"),
+    "iGPU 'video decode 1' (spaces) is video")
+check(vs.is_video_instance(
+    "pid_9_luid_x_phys_0_eng_3_engtype_VideoProcessing"),
+    "VideoProcessing(4) is video")
+check(not vs.is_video_instance(
+    "pid_9_luid_x_phys_0_eng_8_engtype_VideoEncode"),
+    "VideoEncode(3) is NOT: recording is not watching")
+check(not vs.is_video_instance(
+    "pid_9_luid_x_phys_0_eng_10_engtype_JPEG_Decode_3"),
+    "JPEG decode is not a movie")
+check(not vs.is_video_instance(
+    "pid_9_luid_x_phys_0_eng_10_engtype_video codec 0"),
+    "the vendor codec catch-all stays out (the law names 2 and 4)")
+check(not vs.is_video_instance(
+    "pid_9_luid_x_phys_0_eng_0_engtype_3D")
+      and not vs.is_video_instance("pid_1_luid_x_eng_1_engtype_copy"),
+    "3D and copy are not video")
+
+# ---- 2) the mpv matcher truth table -----------------------------------
+check(vs.mpv_is_hdr({"primaries": "bt.2020", "gamma": "pq"}),
+      "bt.2020 + pq is HDR content")
+check(vs.mpv_is_hdr({"primaries": "BT.2020", "gamma": "HLG"}),
+      "case does not move the answer")
+check(vs.mpv_is_hdr({"primaries": "bt2020", "gamma": "smpte-st-pq"}),
+      "the dotted/undotted spellings both read (loose per mpv's own "
+      "warning)")
+check(not vs.mpv_is_hdr({"primaries": "bt.709", "gamma": "srgb"}),
+      "SDR is not HDR")
+check(not vs.mpv_is_hdr({"primaries": "bt.2020"}), "gamma missing -> no")
+check(not vs.mpv_is_hdr({"gamma": "pq"}), "primaries missing -> no")
+check(not vs.mpv_is_hdr({}), "no dict parts -> no")
+check(not vs.mpv_is_hdr(None), "None (the dead pipe's answer shape) -> no")
+check(vs.mpv_hdr_playing(r"\\.\pipe\panelboss-absent-"
+                         + str(os.getpid())) is False,
+      "a pipe nobody owns answers False inside its bounded wait")
+
+# ---- 3) the hysteresis machine, fake-clocked --------------------------
+E, R, st0 = hw.ENGAGE_SEC, hw.RELEASE_SEC, {}
+st, w = hw.hdr_step(st0, 0.0, True, False)
+check(w is None and st["busy_since"] == 0.0,
+      "the first busy tick only starts the clock")
+st, w = hw.hdr_step(st, 0.0 + E - 0.001, True, False)
+check(w is None, "under ENGAGE_SEC of busy: no engage")
+st, w = hw.hdr_step(st, 0.0 + E, True, False)
+check(w is True, "ENGAGE_SEC of unbroken busy lights the panel")
+st, w = hw.hdr_step(st, 100.0, True, True)
+check(w is None, "held busy with the light on: silence, no re-issue")
+st, w = hw.hdr_step(st, 101.0, False, True)
+check(w is None and st["idle_since"] == 101.0,
+      "one idle tick only starts the release clock")
+st, w = hw.hdr_step(st, 101.0 + R - 0.001, False, True)
+check(w is None, "under RELEASE_SEC of idle: the owner keeps HDR")
+st, w = hw.hdr_step(st, 101.0 + R, False, True)
+check(w is False, "RELEASE_SEC of quiet hands it back")
+st, w = hw.hdr_step(st, 200.0, False, False)
+check(w is None and st["idle_since"] is None,
+      "dark and idle: the clocks rest")
+st, w = hw.hdr_step(st0, 5.0, False, True)
+check(w is None, "an idle tick never commands an already-off panel")
+# a flicker inside ENGAGE_SEC resets the engage clock, not a light
+st, _ = hw.hdr_step(st0, 0.0, True, False)
+st, w = hw.hdr_step(st, 1.0, False, False)
+check(w is None and st["busy_since"] is None,
+      "a flinch clears the engage clock (a two-second stutter must "
+      "not flicker a desktop)")
+
+# ---- 4) the arm over faked senses (the tick, not the thread) ---------
+class FakeWM:
+    def __init__(self, rows):
+        self.rows, self.sets = rows, []
+
+    def hdr_states(self):
+        return [dict(r) for r in self.rows]
+
+    def hdr_set(self, gdi, on):
+        self.sets.append((gdi, on))
+        for r in self.rows:
+            if r["gdi"] == gdi:
+                r["state"] = "on" if on else "off"
+        return ""
+
+
+class FakeVS:
+    busy = False
+    playing = False
+    reads = 0
+
+    @staticmethod
+    def video_busy():
+        FakeVS.reads += 1
+        return 60.0 if FakeVS.busy else 0.0
+
+    @staticmethod
+    def mpv_hdr_playing(pipe=None):
+        FakeVS.reads += 1
+        return FakeVS.playing
+
+
+class Mon(hw._HdrWatchMixin):
+    def __init__(self, cfg):
+        self.cfg = cfg
+
+
+fake_wm, fake_vs = hw.wm, hw._videostats
+try:
+    fw = FakeWM([{"gdi": r"\\.\DISPLAY9", "model": "ZZZ1",
+                  "supported": True, "state": "off", "precise": True}])
+    hw.wm, hw._videostats = fw, FakeVS
+    m = Mon({"hdr": {"auto": {"ZZZ1": "video"}}})
+    mst = {}
+    FakeVS.busy = True
+    m._hdr_tick(mst, 0.0)
+    check(fw.sets == [] and mst["ZZZ1"]["busy_since"] == 0.0,
+          "tick 0: the busy clock starts, no command")
+    m._hdr_tick(mst, hw.ENGAGE_SEC)
+    check(fw.sets == [(r"\\.\DISPLAY9", True)],
+          "the arm commands the engage edge EXACTLY once")
+    m._hdr_tick(mst, hw.ENGAGE_SEC + 1)
+    check(len(fw.sets) == 1, "held busy: no repeat command")
+    FakeVS.busy = False
+    for t in range(int(hw.RELEASE_SEC)):         # 100.0 .. 129.0
+        m._hdr_tick(mst, 100.0 + t)
+    check(len(fw.sets) == 1,
+          "idle UNDER RELEASE_SEC: the owner keeps the light")
+    m._hdr_tick(mst, 100.0 + hw.RELEASE_SEC)
+    check(fw.sets == [(r"\\.\DISPLAY9", True),
+                      (r"\\.\DISPLAY9", False)],
+          "the release edge commands once too")
+    # a claimed-but-incapable panel: no clocks, no commands, no lies
+    fw.rows = [{"gdi": r"\\.\DISPLAY9", "model": "ZZZ1",
+                "supported": False, "state": "off", "precise": True}]
+    mst2 = {}
+    m._hdr_tick(mst2, 200.0)
+    check(mst2 == {} and len(fw.sets) == 2,
+          "incapable hardware: no clocks, no commands, no lies")
+    # the default-off shape: an empty tier map reads NO senses
+    fw.sets.clear()
+    before = FakeVS.reads
+    Mon({"hdr": {"auto": {}}})._hdr_tick({}, 0.0)
+    Mon({})._hdr_tick({}, 0.0)
+    check(FakeVS.reads == before and fw.sets == [],
+          "no tiers claimed (the virgin default): zero sense reads")
+    # the content tier end to end through the same machine
+    fw.rows = [{"gdi": r"\\.\DISPLAY9", "model": "ZZZ1",
+                "supported": True, "state": "off", "precise": True}]
+    m = Mon({"hdr": {"auto": {"ZZZ1": "content"},
+                     "mpv_pipe": r"\\.\pipe\tested"}})
+    mst3 = {}
+    FakeVS.playing = True
+    m._hdr_tick(mst3, 0.0)
+    m._hdr_tick(mst3, hw.ENGAGE_SEC)
+    check(fw.sets == [(r"\\.\DISPLAY9", True)],
+          "the player-ipc tier engages on the pipe's HDR answer")
+finally:
+    hw.wm, hw._videostats = fake_wm, fake_vs
+
+# ---- 5) the type-16 migration canary ----------------------------------
+check(_hdr.DCI_SET_HDR_STATE == 16,
+      "the SET door is type 16 (24H2): the legacy type-10 fused "
+      "enable is what windows-display-settings broke on")
+import inspect                                          # noqa: E402
+_src = inspect.getsource(_hdr.hdr_set)
+check("DCI_SET_HDR_STATE" in _src
+      and "DCI_SET_ADVANCED_COLOR_STATE" not in _src,
+      "hdr_set references the type-16 door and never the type-10 one")
+
+print("ALL-HDRWATCH-TESTS-OK" if not fails
+      else "hdrwatch FAILED: %s" % fails)
+sys.exit(1 if fails else 0)
diff --git a/scripts/hold_test.py b/scripts/hold_test.py
index 1ae390c..cfc034b 100644
--- a/scripts/hold_test.py
+++ b/scripts/hold_test.py
@@ -104,13 +104,19 @@ mdir = os.path.join(os.environ.get("TEMP", "."), "panelboss_hold_cfg")
