diff --git a/panelboss/wm/_overlay.py b/panelboss/wm/_overlay.py
new file mode 100644
index 0000000..fc6d332
--- /dev/null
+++ b/panelboss/wm/_overlay.py
@@ -0,0 +1,169 @@
+"""Per-monitor black overlay: the painted lie of a sleeping panel.
+
+One borderless topmost black Toplevel per monitor - on an OLED a full
+black pixel is a pixel at rest, so the fake-off reads as off while the
+panel never cold-boots its ODM (the 16-38 s re-enumeration class this
+whole feature exists to dodge). Geometry arrives in the rows
+wm.monitors() already resolves - nothing here re-derives a rect.
+
+Thread law: the state machine owns its own thread and Tk owns thread
+zero, so the overlay runs its OWN Tk interpreter on a private daemon
+thread; the public calls only ever enqueue onto a thread-safe queue,
+and the interpreter's after(50, pump) loop performs the widget work
+(the app's standing answer to cross-thread Tk - same shape as the
+power assistant's truth queue).
+
+Destroy law: a release withdraws FIRST and destroys on the pump's
+later tick - never inside the click callback that is still on the
+widget's own stack (the withdraw+schedule idiom the tips learned in
+ui/helpbtn.py). Opaque by contract: alpha 1.0 - anything peeking
+through a fake-off OLED unmasks the fake. A click is swallowed AND
+lifts: the callback the caller passed runs first (the UI's cancel-
+now token), then the watcher queue is told ("away_lift", "overlay").
+
+Draw-over safety is the UI's side of the deal (ui/window/_away.py):
+a preview overlay transient-raises its dialog - across Tk
+interpreters transient() does not exist, so topmost+raise is the
+cross-app law that keeps the settings window clickable above a
+blackout preview.
+"""
+
+import logging
+import queue
+import threading
+import time
+
+log = logging.getLogger("wm.overlay")
+
+_BG = "#000000"          # the whole product, in one hex
+_PUMP_MS = 50            # the interpreter's own tick; no busy wait
+_DESTROY_MS = 150        # a release waits this long: off the callback
+
+_root = None
+_windows = {}            # gdi (lower case) -> widget
+_q = queue.Queue()
+_thread = None
+
+
+def _start_root():
+    """The private interpreter, once per process: a withdrawn root and
+    a pump that outlives every window it made."""
+    global _root, _thread
+    if _root is not None:
+        return
+    import tkinter as tk
+
+    def run():
+        global _root
+        root = tk.Tk()
+        root.withdraw()            # the root is scaffolding, never a UI
+        root.title("panelboss-away")
+        _root = root
+        root.option_add("*tearOff", False)
+        root.after(_PUMP_MS, _pump)   # the heartbeat starts on the Tk
+        root.mainloop()               # thread, from here on forever
+
+    _thread = threading.Thread(target=run, daemon=True,
+                               name="away-overlay")
+    _thread.start()
+    for _ in range(100):           # a second at most; a dead Tk says so
+        if _root is not None:
+            break
+        time.sleep(0.01)
+
+
+def _show(gdi, rect, on_click):
+    import tkinter as tk
+    x, y, w, h = rect
+    win = _windows.get(gdi)
+    if win is not None:
+        try:                       # idempotent: re-place, re-lift, restyle
+            win.geometry("%dx%d+%d+%d" % (w, h, x, y))
+            win.configure(bg=_BG)
+            win.attributes("-alpha", 1.0)
+            win.deiconify()
+            win.attributes("-topmost", True)
+            win.lift()
+            return
+        except tk.TclError:
+            _windows.pop(gdi, None)
+    win = tk.Toplevel(_root)
+    win.overrideredirect(True)     # borderless: fake-off has no chrome
+    win.geometry("%dx%d+%d+%d" % (w, h, x, y))
+    win.configure(bg=_BG)
+    win.attributes("-alpha", 1.0)  # opaque, the law above
+    win.attributes("-topmost", True)
+    win.lift()
+    win.protocol("WM_DELETE_WINDOW", lambda: None)   # the tray X
+    win.bind("<Button-1>", lambda e: _click(gdi, on_click))
+    _windows[gdi] = win
+
+
+def _click(gdi, on_click):
+    """A click swallows AND wakes: the caller's token first (a preview
+    cancels now), then the engine's own lift path."""
+    try:
+        if on_click is not None:
+            on_click()
+    except Exception:
+        log.debug("overlay click token failed", exc_info=True)
+    from .. import display         # late: display owns the queue
+    if display.watcher is not None:
+        display.watcher.queue.put(("away_lift", "overlay",
+                                   time.monotonic()))
+
+
+def _hide(gdi):
+    win = _windows.pop(gdi, None)
+    if win is None:
+        return
+    try:
+        win.attributes("-topmost", False)
+        win.withdraw()             # destroy law: off screen first...
+        _root.after(_DESTROY_MS, win.destroy)   # ...off the stack after
+    except Exception:
+        log.debug("overlay destroy skipped", exc_info=True)
+
+
+def _pump():
+    while True:
+        try:
+            try:
+                item = _q.get_nowait()
+            except queue.Empty:
+                break
+            action, args = item
+            if action == "show":
+                _show(*args)
+            elif action == "hide":
+                _hide(args[0])
+        except Exception:
+            log.debug("overlay pump item failed", exc_info=True)
+    if _root is not None:
+        _root.after(_PUMP_MS, _pump)
+
+
+def show(gdi, rect, on_click=None):
+    """Cover one monitor. Idempotent (see _show). rect = (x, y, w, h)
+    from wm.monitors() - device pixels, the app is DPI-unaware."""
+    _start_root()
+    _q.put(("show", (str(gdi).lower(), rect, on_click)))
+
+
+def hide(gdi):
+    """Release one cover. Idempotent - a missing cover is a released
+    cover."""
+    _q.put(("hide", (str(gdi).lower(),)))
+
+
+def hide_all():
+    for gdi in list(_windows):
+        hide(gdi)
+
+
+def shown(gdi=None):
+    """The honest state word for the suites and the row status: the
+    cover list (or whether one specific monitor wears it)."""
+    if gdi is None:
+        return sorted(_windows)
+    return str(gdi).lower() in _windows
diff --git a/panelboss/wm/_sdc.py b/panelboss/wm/_sdc.py
new file mode 100644
index 0000000..bd48acd
--- /dev/null
+++ b/panelboss/wm/_sdc.py
@@ -0,0 +1,324 @@
+"""CCD retraction: the DISCONNECT flavor of away-off (the off-mode
+arc's last wave, owner-ruled 2026-10-14; the measured law is the
+4eaf7ce dossier, the proven marshal is scripts/sdc_off_probe2.py -
+this file is that marshal, app-shaped).
+
+The act: SetDisplayConfig with the target's paths DROPPED from the
+supplied array (PATH-MINUS) and the flags 0x6A0 =
+APPLY|USE_SUPPLIED|SAVE|ALLOW_CHANGES. The dossier's three guard-
+rails, all honored here: SDC_APPLY is 0x80, not 0x1 (0x1|0x2 was the
+verbless topology ask that 0x57'd the first probe at entry);
+SDC_ALLOW_PATH_ORDER_CHANGES is falsified as-is on this 26220/NVIDIA
+stack and stays out; and the ZERO-FLAGS shape is the wrong-victim
+trap (it validates, applies, and lets the CCD re-normalize drop a
+DIFFERENT panel) - which is why every apply here is followed by the
+ONLY honest verification: a QDC_ACTIVE re-query that must show THE
+INTENDED target gone. The GDI row list is never believed for this
+check: the KVM's emulated EDID ghosts a detached slot (DISPLAY3),
+rows lie while the CCD is true.
+
+SAVE_TO_DATABASE means the retraction persists in the HKLM CCD
+store - it survives this app, and a restore that does NOT carry the
+same SAVE bit leaves the stored profile rebooting the panel dark
+(the named footgun; every write here carries SAVE, restore
+included). The boot belt's offdisc door (state/_away.py) answers
+the survival from inside the app: re-query, and if a configured
+row's target sits inactive, raise its path back. Windows refuses to
+disconnect the last active display - that guard arrives as an
+ordinary nonzero rc and the caller degrades to blackout like every
+other refusal, no new code.
+
+SIZE LAW: pure CCD at ~240 (post gate fixes) - the ctypes core of
+the flavor; the row
+ledger, the status words and the belt live in state/_away.py, the
+paint in ui/window/_away.py. Test seams: _capture, _names and
+_apply_cfg are the FFI trio the suite replaces wholesale; everything
+above them is marshal arithmetic that runs unhooked under the fake.
+"""
+import ctypes
+import logging
+import struct
+import time
+from ctypes import wintypes
+
+from . import _hdr
+from ._winapi import k32, u32
+
+log = logging.getLogger("wm")
+QDC_ALL = 0x00000001
+QDC_ACTIVE = _hdr.QDC_ONLY_ACTIVE_PATHS        # 0x2
+SDC_USE_SUPPLIED = 0x00000020
+SDC_VALIDATE = 0x00000040
+SDC_APPLY = 0x00000080         # NOT 0x1 - that is TOPOLOGY_INTERNAL
+SDC_SAVE = 0x00000200          # every write carries it: both flavors
+SDC_ALLOW_CHANGES = 0x00000400 # of the dark-boot footgun law
+RETRACT_FLAGS = SDC_APPLY | SDC_USE_SUPPLIED | SDC_SAVE | SDC_ALLOW_CHANGES
+VALIDATE_FLAGS = SDC_VALIDATE | SDC_USE_SUPPLIED
+SDC_PATH_ACTIVE = 0x00000001   # the path-flag bit the CCD answers with
+PATH_SZ = 72                   # DC_PATH on the table (asserted below)
+assert ctypes.sizeof(_hdr.DC_PATH) == PATH_SZ, "DisplayConfig layout drift"
+
+u32.SetDisplayConfig.argtypes = [wintypes.UINT, ctypes.POINTER(_hdr.DC_PATH),
+                                 wintypes.UINT, ctypes.POINTER(_hdr.DC_MODE),
+                                 wintypes.UINT]
+u32.SetDisplayConfig.restype = ctypes.c_long
+
+VERIFY_TRIES = 4               # the CCD moves inside a tick; measured
+VERIFY_WAIT_SEC = 0.3          # 0.5 s sampling - 1.2 s is generous
+
+
+def _names(psrc, ptgt):
+    """(source gdi name, target device path) - the dossier's identity
+    joins, both halves via DisplayConfigGetDeviceInfo (the probe's
+    name_of, verbatim purpose)."""
+    sn = _hdr.DC_SOURCE_NAME()
+    sn.header.type, sn.header.size = _hdr.DCI_GET_SOURCE_NAME, \
+        ctypes.sizeof(sn)
+    sn.header.adapter, sn.header.id = psrc.adapter, psrc.id
+    u32.DisplayConfigGetDeviceInfo(ctypes.byref(sn.header))
+    tn = _hdr.DC_TARGET_NAME()
+    tn.header.type, tn.header.size = _hdr.DCI_GET_TARGET_NAME, \
+        ctypes.sizeof(tn)
+    tn.header.adapter, tn.header.id = ptgt.adapter, ptgt.id
+    u32.DisplayConfigGetDeviceInfo(ctypes.byref(tn.header))
+    return sn.name, tn.path
+
+
+def _capture(flags):
+    """GBS -> Query, counts from the OS's own answers (never guesses;
+    the probe's read leg). None = the CCD cannot be talked to."""
+    n_p, n_m = wintypes.UINT(0), wintypes.UINT(0)
+    if u32.GetDisplayConfigBufferSizes(flags, ctypes.byref(n_p),
+                                       ctypes.byref(n_m)) != 0:
+        return None
+    paths = (_hdr.DC_PATH * n_p.value)()
+    modes = (_hdr.DC_MODE * n_m.value)()
+    if u32.QueryDisplayConfig(flags, ctypes.byref(n_p), paths,
+                              ctypes.byref(n_m), modes, None) != 0:
+        return None
+    return bytes(bytearray(paths)), bytes(bytearray(modes)), list(paths)
+
+
+def _apply_cfg(path_bytes, modes_bytes, flags):
+    """One SetDisplayConfig over the byte arrays; (rc, gle). The gle
+    is the OS's own GetLastError through the real handle (the
+    windll default carries no ctypes-side error store - the probe's
+    gle column came from the same call). Named _apply_cfg, not
+    _sdc: the wm facade FANS attribute writes through to the parts,
+    and a part's own `_sdc` slot would collide with the module's
+    name in wm._sdc patching (the suite's own seam, learned here)."""
+    n_p = len(path_bytes) // PATH_SZ
+    n_m = len(modes_bytes) // 64
+    pa = (_hdr.DC_PATH * max(n_p, 1)).from_buffer_copy(
+        path_bytes or b"\0" * PATH_SZ) if n_p else None
+    ma = (_hdr.DC_MODE * max(n_m, 1)).from_buffer_copy(
+        modes_bytes or b"\0" * 64) if n_m else None
+    k32.SetLastError(0)
+    rc = u32.SetDisplayConfig(n_p, pa, n_m, ma, flags) & 0xFFFFFFFF
+    return rc, k32.GetLastError()
+
+
+def _rows(flags):
+    """The captured view as marshal rows: (idx, target-key, flags,
+    upper-cased gdi source, upper-cased target model token)."""
+    cap = _capture(flags)
+    if cap is None:
+        return None
+    pb, mb, paths = cap
+    out = []
+    for i, p in enumerate(paths):
+        src, tp = _names(p.src, p.tgt)
+        out.append((i, (p.tgt.adapter.low, p.tgt.adapter.high, p.tgt.id),
+                    p.flags, str(src).upper(),
+                    (tp.split("#")[1].upper() if "#" in tp else "?")))
+    return pb, mb, out
+
+
+def _victim(rows, row):
+    """The target key(s) this app-row names, as (keys, why). The
+    gdi-slot join and the EDID-token join are CROSS-CHECKED (gate
+    fix 2): when both answer and name DIFFERENT targets the answer
+    is NO victim - a slot that re-normalized behind our back must
+    never dark the wrong panel with the witness nodding, so we
+    refuse and say so. One join answering alone carries the row
+    (the ghost's dark slot answers nothing in the active view; a
+    hand-built row names no slot); twins the token cannot single
+    out stay the no-gamble class. why is the honest refusal word
+    when the keys come back empty."""
+    gdi = str(row.get("gdi") or "").upper()
+    tok = str(row.get("short") or "").upper()
+    slot = {r[1] for r in rows if gdi and r[3] == gdi}
+    token = {r[1] for r in rows if r[4] == tok}
+    token = token if len(token) == 1 else set()
+    if slot and token and not (token <= slot):
+        return set(), ("the gdi slot names one panel, the EDID token "
+                       "another (no gamble)")
+    keys = slot or token
+    if keys:
+        return keys, ""
+    if tok and any(r[4] == tok for r in rows):
+        return set(), "several twins answer the token; no slot names one"
+    return set(), "no CCD path answers this row"
+
+
+def _drop(pb, rows, keys):
+    """PATH-MINUS: the kept entries' bytes, order preserved (the
+    falsified ALLOW_PATH_ORDER says the driver may not reshuffle -
+    it gets the order it was given, minus the victim)."""
+    drop = {r[0] for r in rows if r[1] in keys}
+    keep = [i for i in range(len(pb) // PATH_SZ) if i not in drop]
+    return b"".join(pb[i * PATH_SZ:(i + 1) * PATH_SZ] for i in keep), len(keep)
+
+
+def _raise(pb, rows, keys):
+    """The restore shape of the same capture: every victim entry's
+    path flags gain SDC_PATH_ACTIVE (the belt's door, and the
+    already-dark save - both must hand the light back, not re-write
+    the dark)."""
+    buf = bytearray(pb)
+    for i, key, flags, _s, _t in rows:
+        if key in keys and not flags & SDC_PATH_ACTIVE:
+            struct.pack_into("<I", buf, i * PATH_SZ + PATH_SZ - 4,
+                             flags | SDC_PATH_ACTIVE)
+    return bytes(buf)
+
+
+def _gone(victim, tries=VERIFY_TRIES):
+    """The ONLY honest post-apply truth, THREE-valued (gate fix 1):
+    True = the active view no longer carries the victim (verified
+    gone); False = a view answered and the victim is STILL THERE
+    (the wrong-victim class - accepted, nothing dropped as asked);
+    None = BLIND: every re-query refused (gate fix 1's split - the
+    retraction's fate is UNKNOWN, and an unknown must never be
+    sentenced as either class). The GDI rows are not asked (the KVM
+    ghost keeps them lying through the retraction)."""
+    blind = True
+    for _ in range(tries):
+        time.sleep(VERIFY_WAIT_SEC)
+        view = _rows(QDC_ACTIVE)
+        if view is None:
+            continue
+        blind = False
+        if not (victim & {r[1] for r in view[2]}):
+            return True
+    return None if blind else False
+
+
+def retract(row):
+    """Disconnect this row's panel at the adapter. Returns
+    (True, saved) only when the CCD RE-QUERY proves the intended
+    target left the active set (or found it already retracted - the
+    same verified word), else (False, why) with the desk honest: a
+    validate-refusal applies nothing; a wrong-victim or a blind
+    verify restores its own damage before reporting, and the word
+    names WHICH happened and WHETHER the restore took (gate fix 1:
+    'no-drop rc 0x0 (wrong victim; restored)' / '(...; NOT RESTORED:
+    <say>)' / '(verify refused; restored unverified (blind re-query))'
+    - three classes, no misattribution). `saved` is the restore
+    record - the full captured arrays with the victim ACTIVE - the
+    lift hands it back through restore()."""
+    act = _rows(QDC_ACTIVE)
+    if act is None:
+        return False, "the CCD query refused (rc unreadable)"
+    pb, mb, rows = act
+    keys, why = _victim(rows, row)
+    if not keys:
+        al = _rows(QDC_ALL)                       # the ghost's shape:
+        if al is None:                            # GDI row lies, the
+            return False, "no CCD answer at all"  # target exists dark
+        keys, why = _victim(al[2], row)           # the ALL view gets
+        if not keys:                              # the same cross-
+            return False, why                     # check; a
+            #                                     # disagreement
+                                                  # outranks mercy
+        return True, {"paths": _raise(al[0], al[2], keys), "modes": al[1],
+                      "victim": keys, "at": time.time()}
+    minus, _n = _drop(pb, rows, keys)
+    rc, gle = _apply_cfg(minus, mb, VALIDATE_FLAGS)
+    if rc:
+        return False, "validate rc 0x%X gle=%d" % (rc, gle)
+    rc, gle = _apply_cfg(minus, mb, RETRACT_FLAGS)
+    if rc:
+        return False, "rc 0x%X gle=%d" % (rc, gle)
+    gone = _gone(keys)
+    if gone is True:
+        return True, {"paths": pb, "modes": mb, "victim": keys,
+                      "at": time.time()}
+    r_ok, r_why = restore({"paths": pb, "modes": mb, "victim": keys,
+                           "at": time.time()})
+    reason = "wrong victim" if gone is False else "verify refused"
+    if r_ok:
+        back = "restored"
+    elif gone is None and r_why == "the re-query stayed blind":
+        # blind inside blind: the restore's WRITE took the same rc
+        # the retraction's took - it is the CHECK that cannot see,
+        # so the word says restored-unverified, never NOT RESTORED
+        # (gate fix 1: the misattribution class, one clause deep)
+        back = "restored unverified (blind re-query)"
+    else:
+        back = "NOT RESTORED: %s" % r_why
+    return False, "no-drop rc 0x0 (%s; %s)" % (reason, back)
+
+
+def restore(saved):
+    """Hand the panel back: re-apply the saved arrays WITH the SAVE
+    bit (a restore without it leaves the store rebooting the panel
+    dark - the footgun, closed at every write). (True, "") only when
+    the re-query sees the target active again; the why names WHICH
+    failure answered (still-dark vs blind - gate fix 1's honesty
+    travels every verify seam)."""
+    rc, gle = _apply_cfg(saved["paths"], saved["modes"], RETRACT_FLAGS)
+    if rc:
+        return False, "restore rc 0x%X gle=%d" % (rc, gle)
+    came = _victim_active(saved["victim"])
+    if came is True:
+        return True, ""
+    if came is False:
+        return False, "the target never came back"
+    return False, "the re-query stayed blind"
+
+
+def revive(row):
+    """The boot belt's door, no in-memory record needed: re-query the
+    ALL view, and when this row's target sits there INACTIVE, raise
+    its path back with the SAVE bit. None = nothing to do (the row
+    is lit, twins the token cannot single out, or no path answers it
+    - the belt's silent classes, same religion as the D6 door);
+    (ok, why) = the belt already logged the act either way. A
+    slot/token DISAGREEMENT is loud for callers that NAME a gdi -
+    but the belt's own call shape ({"short", "gdi": ""}) carries no
+    slot to cross-check, so disputes stay SILENT BY DESIGN on the
+    belt's road and the loud branch below is defensive for the
+    gdi-naming callers that may come (dossier follow-up 2: the
+    comment, not the branch, was the lie)."""
+    al = _rows(QDC_ALL)
+    if al is None:
+        return None
+    pb, mb, rows = al
+    keys, why = _victim(rows, row)
+    if keys and any(r[1] in keys and r[2] & SDC_PATH_ACTIVE for r in rows):
+        return None                               # lit: silence
+    if not keys:
+        return (False, why) if "no gamble" in why else None
+    rc, gle = _apply_cfg(_raise(pb, rows, keys), mb, RETRACT_FLAGS)
+    return (rc == 0 and _victim_active(keys) is True), \
+        "rc 0x%X gle=%d" % (rc, gle)
+
+
+def _victim_active(keys, tries=VERIFY_TRIES):
+    """True/False for an answering view; None = BLIND (no verdict
+    about the glass, only about the check). THE SAME PATIENCE _gone
+    earned (dossier follow-up 1): the CCD reactivates a path on its
+    own schedule - one immediate look false-warned 'never came
+    back' on a merely slow store, so every verify seam re-looks
+    within the same budget."""
+    blind = True
+    for _ in range(tries):
+        time.sleep(VERIFY_WAIT_SEC)
+        view = _rows(QDC_ACTIVE)
+        if view is None:
+            continue
+        blind = False
+        if keys & {r[1] for r in view[2]}:
+            return True
+    return None if blind else False
diff --git a/panelboss/wm/_videostats.py b/panelboss/wm/_videostats.py
new file mode 100644
index 0000000..784e448
--- /dev/null
+++ b/panelboss/wm/_videostats.py
@@ -0,0 +1,217 @@
+"""Video-engine activity and HDR-content presence, for the auto-switch
+(amendment 8). Two public probes, both fail-open, neither elevates:
+
+  video_busy()  PDH's GPU Engine UTILIZATION counters, summed over the
+                video-family engines only - Task Manager's own source,
+                public and unelevated. The instance shape is measured
+                on this box (Oct 13): ``pid_<pid>_luid_<luid>_phys_<n>_
+                eng_<ordinal>_engtype_<KIND>`` (NVIDIA spells the kind
+                ``VideoDecode``, an iGPU with spaces, ``video decode
+                1``; the matcher normalizes both). The engine-type
+                enum: DXGK/D3DKMT ENGINE_TYPE - VIDEO_DECODE=2,
+                VIDEO_ENCODE=3, VIDEO_PROCESSING=4, per the manifest
+                docs:
+                https://learn.microsoft.com/en-us/windows-hardware/drivers/ddi/d3dkmdt/ne-d3dkmdt-dxgk_engine_type
+                We take DECODE(2) and PROCESSING(4) and deliberately
+                NOT ENCODE(3): encoding means recording/streaming,
+                and someone recording the desktop is not watching
+                HDR. JPEG decode and the vendor "video codec" catch-
+                alls are excluded the same way - photos are not a
+                movie.
+
+  mpv_hdr_playing(pipe)  the player-ipc tier: ask an mpv (started
+                with --input-ipc-server=<pipe>) for video-params and
+                let the PURE matcher mpv_is_hdr() decide: primaries
+                bt.2020 and gamma pq/hlg is HDR content, per mpv's
+                own docs; the matching is deliberately loose (case,
+                punctuation, the documented gamma aliases) because
+                mpv warns its property shapes may gain spellings.
+                MPC-HC's command channel is a documented FOLLOW-UP.
+
+Size law (measured 217, Oct 13, the claim includes its own lines):
+the module
+is the counter/pipe vocabulary plus two probes over it; the state
+machine that ACTS on the verdicts lives in state/_hdrwatch.py (pure,
+fake-clocked tests). The mechanics mirror panelboss/gpu.py (measured
+on this build: fresh query per call, one collect pair, wildcard array
+reads die of heap corruption so every counter is added per-instance);
+the one deliberate difference: PdhAddEnglishCounterW, the locale-
+proof door - gpu.py entered through the localized one and survives
+only because this desk speaks English. (Measured at first import,
+Oct 13: the packet's "PdhAddEnglishCounterPath" spelling does not
+exist in pdh.dll - the English export's real name has no Path; the
+loader said so and this header remembers.)
+"""
+
+import ctypes
+import json
+import logging
+import re
+import time
+from ctypes import wintypes as W
+
+log = logging.getLogger("videostats")
+
+try:
+    pdh = ctypes.WinDLL("pdh.dll")
+except (OSError, AttributeError):
+    pdh = None
+
+# the vocabulary the offline suite asserts against (no live counters
+# in tests - amendment 8 item 3): one path template over the measured
+# instance names, English, locale-proof through
+# PdhAddEnglishCounterPathW.
+OBJECT = "GPU Engine"
+COUNTER = "Utilization Percentage"
+COUNTER_PATH = "\\GPU Engine(%s)\\Utilization Percentage"
+
+# engine-kind fragments, normalized (lower, non-alnum stripped): the
+# decode(2)/processing(4) family - see the module header for why
+# encode(3) and the jpeg/codec catch-alls stay out
+VIDEO_KINDS = ("videodecode", "videoprocessing")
+
+MPV_PIPE_DEFAULT = r"\\.\pipe\mpv-video"   # the convention: mpv was
+# started --input-ipc-server=\.\pipe\mpv-video; cfg [hdr] mpv_pipe
+# overrides, one player per desk for now
+MPV_HDR_GAMMAS = ("pq", "smptestpq", "hlg", "aribstdb67")
+PIPE_WAIT_MS = 100        # no server: bound the wait, answer not-hdr
+COLLECT_GAP_SEC = 1.2     # the PDH delta window (gpu.py's measured
+                          # number, same provider same truth)
+CAP = 400                 # instances tracked per call (gpu.py's net)
+
+_INST_RE = re.compile(r"pid_(\d+)_", re.I)
+
+
+def _norm(name):
+    return re.sub(r"[^a-z0-9]", "", str(name).lower())
+
+
+def is_video_instance(name):
+    """True when the GPU Engine instance name is a video-family engine
+    we trust as a watch signal (decode/processing; not encode, not
+    jpeg, not the vendor codec catch-all)."""
+    s = _norm(name)
+    return any(frag in s for frag in VIDEO_KINDS)
+
+
+if pdh is not None:
+    pdh.PdhEnumObjectItemsW.argtypes = [W.LPCWSTR, W.LPCWSTR, W.LPCWSTR,
+                                        W.LPWSTR, ctypes.POINTER(W.DWORD),
+                                        W.LPWSTR, ctypes.POINTER(W.DWORD),
+                                        W.DWORD, W.DWORD]
+    pdh.PdhOpenQueryW.argtypes = [W.LPCWSTR, W.DWORD,
+                                  ctypes.POINTER(W.HANDLE)]
+    pdh.PdhAddEnglishCounterW.argtypes = [W.HANDLE, W.LPCWSTR, W.DWORD,
+                                          ctypes.POINTER(W.HANDLE)]
+    pdh.PdhCollectQueryData.argtypes = [W.HANDLE]
+    pdh.PdhGetFormattedCounterValue.restype = W.DWORD
+    pdh.PdhGetFormattedCounterValue.argtypes = [
+        W.HANDLE, W.DWORD, ctypes.POINTER(W.DWORD), W.LPVOID]
+    pdh.PdhCloseQuery.restype = None
+    pdh.PdhCloseQuery.argtypes = [W.HANDLE]
+
+k32 = ctypes.windll.kernel32        # the pipe gate lives here, not
+k32.WaitNamedPipeW.restype = W.BOOL  # in pdh.dll (measured: it is not
+k32.WaitNamedPipeW.argtypes = [W.LPCWSTR, W.DWORD]   # a pdh export)
+
+
+class _FMTV(ctypes.Structure):
+    """The plain PDH counter value layout gpu.py picked as the winner
+    of record on this build (its header carries the measurement)."""
+    _fields_ = [("CStatus", W.DWORD), ("Pad", W.DWORD),
+                ("Value", ctypes.c_double)]
+
+
+def _video_instances():
+    csz, isz = W.DWORD(0), W.DWORD(0)
+    pdh.PdhEnumObjectItemsW(None, None, OBJECT, None, ctypes.byref(csz),
+                            None, ctypes.byref(isz), 0, 0)
+    cb = ctypes.create_unicode_buffer(max(csz.value, 2))
+    ib = ctypes.create_unicode_buffer(max(isz.value, 2))
+    if pdh.PdhEnumObjectItemsW(None, None, OBJECT, cb, ctypes.byref(csz),
+                               ib, ctypes.byref(isz), 0, 0):
+        return []
+    names = [t for t in bytes(ib).decode("utf-16", "ignore").split("\0")
+             if t and is_video_instance(t)]
+    names.sort()
+    return names[:CAP]
+
+
+def video_busy():
+    """Total video-engine utilization percent right now (float, >= 0).
+    Blocks ~COLLECT_GAP_SEC by design (the PDH delta window - gpu.py's
+    measured law); callers run off the UI thread. Fail-open: 0.0 on
+    any trouble, including no pdh.dll and an ancient Windows."""
+    if pdh is None:
+        return 0.0
+    q = None
+    try:
+        inst = _video_instances()
+        if not inst:
+            return 0.0
+        hq = W.HANDLE()
+        if pdh.PdhOpenQueryW(None, 0, ctypes.byref(hq)):
+            return 0.0
+        q = hq
+        handles = []
+        for n in inst:
+            h = W.HANDLE()
+            if pdh.PdhAddEnglishCounterW(q, COUNTER_PATH % n, 0,
+                                         ctypes.byref(h)):
+                continue          # died mid-enum->add: churn, keep going
+            handles.append(h)
+        if not handles:
+            return 0.0
+        if pdh.PdhCollectQueryData(q):
+            return 0.0
+        time.sleep(COLLECT_GAP_SEC)
+        if pdh.PdhCollectQueryData(q):
+            return 0.0
+        total = 0.0
+        for h in handles:
+            f = _FMTV()
+            if pdh.PdhGetFormattedCounterValue(h, 0x00000800, None,
+                                               ctypes.byref(f)):
+                continue
+            total += f.Value
+        return max(total, 0.0)
+    except Exception:
+        log.debug("video_busy failed", exc_info=True)
+        return 0.0
+    finally:
+        if q is not None:
+            try:
+                pdh.PdhCloseQuery(q)
+            except Exception:
+                pass
+
+
+def mpv_is_hdr(params):
+    """PURE matcher over one mpv video-params dict: primaries bt.2020
+    AND gamma in (pq, hlg) (+ the documented aliases) is HDR content.
+    Missing keys, a non-dict, an SDR answer - all False. The loose
+    normalization (case, dots, dashes) is mpv's own warning made
+    code: the property vocabulary may gain spellings, the two facts
+    we ask are not among them."""
+    if not isinstance(params, dict):
+        return False
+    return (_norm(params.get("primaries")) == "bt2020"
+            and _norm(params.get("gamma")) in MPV_HDR_GAMMAS)
+
+
+def mpv_hdr_playing(pipe=MPV_PIPE_DEFAULT):
+    """The live half: ask the pipe for video-params, hand the answer
+    to the matcher. No server inside PIPE_WAIT_MS (or a player with
+    no video, or a dead pipe) answers False - fail-open, the watcher
+    simply never engages for a player that is not playing."""
+    try:
+        if not k32.WaitNamedPipeW(pipe, PIPE_WAIT_MS):
+            return False
+        with open(pipe, "w+b", buffering=0) as fh:
+            fh.write(b'{"command":["get_property","video-params"]}\n')
+            fh.flush()
+            reply = json.loads(fh.readline().decode("utf-8"))
+        return mpv_is_hdr(reply.get("data"))
+    except Exception:
+        log.debug("mpv pipe probe failed for %s", pipe, exc_info=True)
+        return False
